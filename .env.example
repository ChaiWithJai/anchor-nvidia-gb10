HACKATHON_BUNDLE=/media/dell/T7/hackathon-2026-08-22
NVIDIA_VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
NEMOTRON_PORT=18000
CARELINE_PORT=8100
# Optional override; run-nvidia defaults this under HACKATHON_BUNDLE.
# CARELINE_STT_MODEL_DIR=/absolute/path/to/whisper-tiny-en
# Local-only MongoDB root credential; change outside a staffed demo.
MONGO_PASSWORD=anchor-gb10-local-only
# Optional localhost-only MongoDB inspector (`--profile inspect`).
MONGO_EXPRESS_USERNAME=anchor-inspector
# MONGO_EXPRESS_PASSWORD=replace-with-a-separate-inspector-password
# MONGO_EXPRESS_PORT=8081
# Required only by scripts/share-nvidia; use a private value with 12+ characters.
# Set by the OpenShell/OpenClaw launcher; leave blank to disable agent delivery.
# CARELINE_OPENCLAW_WAKE_URL=http://<anchor-compose-gateway>:18790/hooks/wake
# CARELINE_OPENCLAW_HOOK_TOKEN=replace-with-a-separate-local-hook-token
# ANCHOR_DEMO_ACCESS_KEY=replace-with-a-private-team-code
